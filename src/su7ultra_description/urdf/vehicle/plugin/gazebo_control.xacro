<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="gazebo_control_plugin">
        <!-- 阿克曼驱动插件 -->
        <gazebo>
            <plugin name='gazebo_ackermann_drive' filename='libgazebo_ros_ackermann_drive.so'>
                <ros>
                    <namespace>/</namespace>
                    <remapping>cmd_vel:=cmd_vel</remapping>
                    <remapping>odom:=odom</remapping>
                </ros>

                <update_rate>50.0</update_rate>

                <!-- 车轮关节 -->
                <front_left_joint>front_left_wheel_joint</front_left_joint>
                <front_right_joint>front_right_wheel_joint</front_right_joint>
                <rear_left_joint>rear_left_wheel_joint</rear_left_joint>
                <rear_right_joint>rear_right_wheel_joint</rear_right_joint>
                
                <!-- 转向关节 -->
                <left_steering_joint>front_left_steering_joint</left_steering_joint>
                <right_steering_joint>front_right_steering_joint</right_steering_joint>
                
                <!-- 方向盘关节（如果没有就注释掉） -->
                <!-- <steering_wheel_joint>virtual_steering_wheel_joint</steering_wheel_joint> -->
                
                <!-- 最大转向角 -->
                <max_steer>0.699</max_steer>
                <max_steering_angle>1.570796</max_steering_angle>
                <max_speed>5.0</max_speed>

                <!-- 🔧 根据你的 C++ 代码修改 PID 参数 -->
                <!-- 左转向 PID：P=2000, I=0, D=300 -->
                <left_steering_pid_gain>5000 0 800</left_steering_pid_gain>
                <left_steering_i_range>0 0</left_steering_i_range>
                
                <!-- 右转向 PID：P=2000, I=0, D=300 -->
                <right_steering_pid_gain>5000 0 800</right_steering_pid_gain>
                <right_steering_i_range>0 0</right_steering_i_range>
                
                <!-- 速度 PID：P=1000, I=0, D=1 -->
                <linear_velocity_pid_gain>2000 0 2</linear_velocity_pid_gain>
                <linear_velocity_i_range>0 0</linear_velocity_i_range>

                <!-- 输出设置 -->
                <publish_odom>true</publish_odom>
                <publish_odom_tf>true</publish_odom_tf>
                <publish_wheel_tf>false</publish_wheel_tf>
                <publish_distance>true</publish_distance>

                <odometry_frame>odom</odometry_frame>
                <robot_base_frame>base_footprint</robot_base_frame>

            </plugin>
        </gazebo>
        <!-- 关节状态发布插件 -->
        <gazebo>
            <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
                <ros>
                    <namespace>/</namespace>
                    <remapping>~/out:=/joint_states</remapping>
                </ros>
                <update_rate>50</update_rate>
                <joint_name>front_left_steering_joint</joint_name>
                <joint_name>front_right_steering_joint</joint_name>
                <joint_name>front_left_wheel_joint</joint_name>
                <joint_name>front_right_wheel_joint</joint_name>
                <joint_name>rear_left_wheel_joint</joint_name>
                <joint_name>rear_right_wheel_joint</joint_name>
            </plugin>
        </gazebo>
        
    </xacro:macro>
</robot>